  "license": "MIT",
  "scripts": {
    "dev": "npx pnpm --filter @workspace/creatorpulse run dev",
    "build": "npx pnpm run typecheck && npx pnpm -r --if-present run build",
    "build:vite": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck:libs": "tsc --build",
    "typecheck": "npx pnpm run typecheck:libs && npx pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint .",
    "db:studio": "npx pnpm --filter @workspace/db exec drizzle-kit studio --config ./drizzle.config.ts",
    "preview": "vite preview"
  },
